# ==========================================================
#  Tuition Media — .gitignore
#  Place this file in the PROJECT ROOT (next to server/,
#  client/, database/, docs/). One file covers everything.
# ==========================================================


# ----------------------------------------------------------
#  1. Dependencies  —  NEVER commit these
# ----------------------------------------------------------
# node_modules is huge (often 200MB+ and 50,000+ files) and is
# fully rebuilt by "npm install" from package.json. Committing it
# would make your repo unusable.

node_modules/
server/node_modules/
client/node_modules/
jspm_packages/

# NOTE: package-lock.json is NOT ignored — commit it.
# It locks exact dependency versions so your project installs
# identically on every machine.


# ----------------------------------------------------------
#  2. Environment variables  —  SECRETS, never commit
# ----------------------------------------------------------
# These hold your PostgreSQL password and JWT_SECRET. If pushed to
# a public repo, anyone can read them. .env.example is the safe
# placeholder version and SHOULD be committed.

.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

server/.env
client/.env

# Keep the templates
!.env.example
!server/.env.example
!client/.env.example


# ----------------------------------------------------------
#  3. Security keys and certificates
# ----------------------------------------------------------
*.pem
*.key
*.crt
*.p12
secrets/


# ----------------------------------------------------------
#  4. Frontend build output
# ----------------------------------------------------------
# Generated by "npm run build". Rebuilt on every deploy, so there
# is no reason to store it in Git.

client/build/
client/dist/
client/.vite/
build/
dist/
.next/
out/


# ----------------------------------------------------------
#  5. User uploads (Multer)
# ----------------------------------------------------------
# Question images, profile pictures, resource PDFs and documents
# uploaded by users are runtime data, not source code. We ignore
# the FILES but keep the FOLDERS, because Git cannot track an
# empty directory.
#
# For this to work you must create a .gitkeep file inside each
# upload subfolder, e.g.:
#   touch server/src/uploads/questions/.gitkeep
#   touch server/src/uploads/profile-pictures/.gitkeep
#   touch server/src/uploads/resources/.gitkeep

server/src/uploads/**/*
!server/src/uploads/**/
!server/src/uploads/**/.gitkeep


# ----------------------------------------------------------
#  6. Logs
# ----------------------------------------------------------
logs/
server/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ----------------------------------------------------------
#  7. Testing and coverage reports
# ----------------------------------------------------------
coverage/
*.lcov
.nyc_output/


# ----------------------------------------------------------
#  8. Database — local dumps and backups only
# ----------------------------------------------------------
# IMPORTANT: schema.sql, seed_subjects.sql, functions.sql and
# everything else in database/ ARE tracked — they are part of
# the project. Only machine-generated dumps and personal backups
# are ignored.

database/backups/
database/dumps/
*.dump
*.bak
*.sqlite
*.sqlite3
*.db


# ----------------------------------------------------------
#  9. Editor and IDE settings
# ----------------------------------------------------------
# Personal editor config — different for every teammate.

.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.history/


# ----------------------------------------------------------
#  10. Operating system junk files
# ----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# ----------------------------------------------------------
#  11. Caches and temporary files
# ----------------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.npm/
.yarn/cache/
.temp/
tmp/
temp/
*.tmp
*.pid
*.seed
*.pid.lock


# ----------------------------------------------------------
#  12. Deployment platform folders
# ----------------------------------------------------------
.vercel/
.netlify/
.serverless/
.firebase/


# ----------------------------------------------------------
#  13. Optional / project-specific
# ----------------------------------------------------------
# Uncomment a line below if it applies to you later.

# *.zip
# *.tar.gz
# docs/drafts/